# Copy this file to ".env.shopify" and fill in the real values.
# .env.shopify is gitignored and will NOT be committed.
# Delete/rotate these tokens in Shopify once the migration is done.

# Your store's permanent myshopify domain (NOT a custom domain), e.g. little-town.myshopify.com
SHOPIFY_STORE=your-store.myshopify.com

# Theme Access app password — install the free "Theme Access" app, Add password.
# Used for: pushing the theme (shopify theme push).
SHOPIFY_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom app Admin API access token — Settings > Apps > Develop apps > create app.
# Scopes needed: write_products, write_content, write_online_store_navigation, read_themes
# Used for: creating products, variants, pages, and the nav menu.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
