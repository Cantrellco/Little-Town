# Node dependencies (root build tooling: sharp, csso) — keep package-lock.json
node_modules/

# Image-optimizer idempotency cache (local; regenerated by optimize-images.js)
scripts/.img-cache.json

# Screenshot / design scratch artifacts
_shot/

# Live-store scratch: curl cookie jars hold real Shopify SESSION COOKIES, plus
# saved page dumps. Treat like credentials — never commit.
_live/

# Built theme artifact (regenerate with: node scripts/make-theme-zip.js)
theme.zip

# Shopify credentials — NEVER commit. Treat tokens like passwords.
.env.shopify
.env
.env.*
!.env.shopify.example
_drop-photos/
