<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- liquid
    assign meta_key = template.suffix
    if template.name == 'index'
      assign meta_key = 'index'
    endif
    # Fail-safe: when a page sits on the default page template (no suffix),
    # use the page's own handle as the key so it still picks up the right CSS
    # + meta. Pairs with the handle-routed default page.liquid below.
    if meta_key == blank and template.name == 'page'
      assign meta_key = page.handle
    endif
  -%}
  {%- case meta_key -%}
    {%- when 'index' -%}{%- assign meta_title = "Little Town Playhouse — A little town built for big imaginations" -%}{%- assign meta_desc = "A warm, imaginative indoor play town for little ones. Become a member for unlimited play, plus open play, private parties, and great coffee next door at Fusion." -%}{%- assign page_css = "home.css" -%}
    {%- when 'play-pricing' -%}{%- assign meta_title = "Play &amp; Pricing — Little Town Playhouse" -%}{%- assign meta_desc = "Open imaginative play through our little downtown storefronts. Day Pass and Play Pack pricing, age policies and play-floor rules." -%}{%- assign page_css = "play-pricing.css" -%}
    {%- when 'parties' -%}{%- assign meta_title = "Parties — Rent the whole town | Little Town Playhouse" -%}{%- assign meta_desc = "Book a private buyout of Little Town Playhouse — exclusive use for two hours. Booking mockup, deposit and cancellation policy, gallery and FAQ." -%}{%- assign page_css = "parties.css" -%}
    {%- when 'memberships' -%}{%- assign meta_title = "Memberships — Little Town Playhouse" -%}{%- assign meta_desc = "Monthly and Annual memberships for unlimited imaginative play at Little Town Playhouse — grown-ups always play free, cancel anytime." -%}{%- assign page_css = "memberships.css" -%}
    {%- when 'fusion' -%}{%- assign meta_title = "Fusion — Coffee next door | Little Town Playhouse" -%}{%- assign meta_desc = "Fusion is the sister café next door to Little Town Playhouse — locally roasted coffee, fresh snacks and little treats, served all day." -%}{%- assign page_css = "fusion.css" -%}
    {%- when 'photo-gallery' -%}{%- assign meta_title = "Photo Gallery — Little Town Playhouse" -%}{%- assign meta_desc = "A peek inside Little Town Playhouse — a gallery of the play floor, the storefronts and the little ones who run the show." -%}{%- assign page_css = "photo-gallery.css" -%}
    {%- when 'visit-us' -%}{%- assign meta_title = "Visit Us — Little Town Playhouse" -%}{%- assign meta_desc = "Hours, address and directions for Little Town Playhouse on Main Street, Riverbend. Get in touch and find answers to common visitor questions." -%}{%- assign page_css = "visit-us.css" -%}
    {%- else -%}{%- assign meta_title = page_title -%}{%- assign meta_desc = page_description -%}{%- assign page_css = blank -%}
  {%- endcase -%}
  <title>{{ meta_title }}</title>
  {%- if meta_desc != blank -%}<meta name="description" content="{{ meta_desc }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,700&display=swap" rel="stylesheet">
  {%- if page_css contains 'fusion' -%}<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">{%- endif -%}
  <link rel="icon" href="{{ 'logo.png' | asset_url }}" type="image/png">
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {%- if page_css != blank -%}{{ page_css | asset_url | stylesheet_tag }}{%- endif -%}
  {{ content_for_header }}
</head>
<body>
  {% section 'header' %}
  {{ content_for_layout }}
  {% section 'footer' %}
  {{ 'main.js' | asset_url | script_tag }}
</body>
</html>
