{%- assign daypass_prod = all_products['day-pass'] -%}
{%- if daypass_prod == blank -%}{%- for p in collections.all.products -%}{%- if p.handle contains 'day' and p.handle contains 'pass' -%}{%- assign daypass_prod = p -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- assign dp_v1 = blank -%}{%- assign dp_v2 = blank -%}{%- assign dp_v3 = blank -%}
{%- if daypass_prod != blank -%}
{%- for v in daypass_prod.variants -%}{%- if v.title contains '1 Child' -%}{%- assign dp_v1 = v -%}{%- elsif v.title contains '2 Child' -%}{%- assign dp_v2 = v -%}{%- elsif v.title contains '3' -%}{%- assign dp_v3 = v -%}{%- endif -%}{%- endfor -%}
{%- if dp_v1 == blank -%}{%- assign dp_v1 = daypass_prod.variants[0] -%}{%- endif -%}
{%- if dp_v2 == blank -%}{%- assign dp_v2 = daypass_prod.variants[1] -%}{%- endif -%}
{%- if dp_v3 == blank -%}{%- assign dp_v3 = daypass_prod.variants[2] -%}{%- endif -%}
{%- endif -%}
<main>
    <!-- ============ HERO (full-bleed animated background) ============ -->
    <section class="hero-v2 has-sparkles">
      <!-- Soft rolling lawn the whole scene rests on — sits behind the town so
           the buildings, trees and bushes all share one grounded green base
           that meets the wave divider below instead of floating on flat sky. -->
      <div class="hero-ground" aria-hidden="true"><img src="{{ 'deco-meadow.svg' | asset_url }}" alt="" width="1440" height="220" decoding="async"></div>
      <!-- Town backdrop is the brand logo mark — the same little town from the
           header — sitting on the sky wash. The motion lives in the separate
           cloud layer below. -->
      <picture class="hero-bg">
        <source type="image/webp" srcset="{{ 'logo.webp' | asset_url }}">
        <img src="{{ 'logo.png' | asset_url }}" alt="The Little Town mark — a grocery with a slide, café tower and clinic." fetchpriority="high" decoding="async">
      </picture>
      <div class="hero-scrim" aria-hidden="true"></div>
      <!-- Clouds: an endless left-to-right conveyor. The track holds one set of
           clouds plus an identical copy and slides by exactly one set width, so
           clouds keep streaming in from the left with no gap or visible reset. -->
      <div class="hero-clouds" aria-hidden="true">
        <div class="cloud-track">
          <div class="cloud-set">
            <img class="hero-cloud c1" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c2" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c3" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c4" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c5" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
          </div>
          <div class="cloud-set">
            <img class="hero-cloud c1" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c2" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c3" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c4" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
            <img class="hero-cloud c5" src="{{ 'deco-cloud.svg' | asset_url }}" alt="" width="120" height="60">
          </div>
        </div>
      </div>
      <!-- Hero scene flourishes — a sunny sky and a little parkland framing the
           town. These are desktop-only floaters (.deco hides under 880px). -->
      <!-- sky, left: a bobbing balloon cluster + a twinkle -->
      <span class="deco anim-bob" style="top:12%;left:6%;width:44px"><img src="{{ 'deco-balloon.svg' | asset_url }}" alt=""></span>
      <span class="deco anim-bob slow" style="top:19%;left:11.5%;width:30px"><img src="{{ 'deco-balloon.svg' | asset_url }}" alt=""></span>
      <span class="deco anim-twinkle" style="top:34%;left:15%;width:26px"><img src="{{ 'deco-star.svg' | asset_url }}" alt=""></span>
      <!-- sky, right: a slowly turning sun, a swaying kite + a twinkle -->
      <span class="deco anim-spin-slow" style="top:6%;right:5%;width:120px"><img src="{{ 'deco-sun.svg' | asset_url }}" alt=""></span>
      <span class="deco anim-sway" style="top:28%;right:13%;width:80px"><img src="{{ 'deco-kite.svg' | asset_url }}" alt=""></span>
      <span class="deco anim-twinkle" style="top:14%;right:27%;width:20px"><img src="{{ 'deco-star.svg' | asset_url }}" alt=""></span>
      <!-- Parkland — little groves nestled on the lawn, flanking the town. Each
           side layers a tall tree behind a bush and a low shrub so the flanks
           read full and rooted (not lone floaters), and bridge toward the town. -->
      <span class="deco" style="bottom:46px;left:2%;width:126px"><img src="{{ 'deco-tree.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:30px;left:11%;width:112px"><img src="{{ 'deco-bush.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:34px;left:19.5%;width:72px"><img src="{{ 'deco-bush.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:22px;left:7%;width:60px"><img src="{{ 'deco-flowers.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:50px;right:2%;width:134px"><img src="{{ 'deco-tree.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:30px;right:10.5%;width:108px"><img src="{{ 'deco-bush.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:34px;right:18.5%;width:74px"><img src="{{ 'deco-bush.svg' | asset_url }}" alt=""></span>
      <span class="deco" style="bottom:22px;right:6%;width:64px"><img src="{{ 'deco-flowers.svg' | asset_url }}" alt=""></span>
      <!-- Phone/tablet hero scene — a lively, phone-tuned parkland + sky so the
           small-screen hero matches the desktop's life. The desktop .deco
           floaters above are hidden ≤880px; this lighter, repositioned set
           (sized + placed for a narrow screen so it frames the copy instead of
           crowding it) takes over there. Positions live in pages/home.css.
           Decorative only. -->
      <div class="hero-scene-m" aria-hidden="true">
        <span class="m-deco m-sun anim-spin-slow"><img src="{{ 'deco-sun.svg' | asset_url }}" alt="" width="54" height="54" loading="lazy" decoding="async"></span>
        <span class="m-deco m-balloon anim-bob"><img src="{{ 'deco-balloon.svg' | asset_url }}" alt="" width="30" height="45" loading="lazy" decoding="async"></span>
        <span class="m-deco m-balloon-2 anim-bob slow"><img src="{{ 'deco-balloon.svg' | asset_url }}" alt="" width="22" height="33" loading="lazy" decoding="async"></span>
        <span class="m-deco m-kite anim-sway"><img src="{{ 'deco-kite.svg' | asset_url }}" alt="" width="40" height="83" loading="lazy" decoding="async"></span>
        <span class="m-deco m-star-1 anim-twinkle"><img src="{{ 'deco-star.svg' | asset_url }}" alt="" width="15" height="15" loading="lazy" decoding="async"></span>
        <span class="m-deco m-star-2 anim-twinkle"><img src="{{ 'deco-star.svg' | asset_url }}" alt="" width="13" height="13" loading="lazy" decoding="async"></span>
        <span class="m-deco m-tree-l"><img src="{{ 'deco-tree.svg' | asset_url }}" alt="" width="84" height="123" loading="lazy" decoding="async"></span>
        <span class="m-deco m-flowers-l"><img src="{{ 'deco-flowers.svg' | asset_url }}" alt="" width="44" height="33" loading="lazy" decoding="async"></span>
        <span class="m-deco m-tree-r"><img src="{{ 'deco-tree.svg' | asset_url }}" alt="" width="88" height="128" loading="lazy" decoding="async"></span>
        <span class="m-deco m-flowers-r"><img src="{{ 'deco-flowers.svg' | asset_url }}" alt="" width="46" height="35" loading="lazy" decoding="async"></span>
      </div>
      <div class="container hero-content reveal">
        <span class="eyebrow">Indoor imaginative play · <span style="white-space:nowrap">Ages 2–7</span></span>
        <h1 class="home-hero-title">A little town built for <span class="hl hl--sky">big</span> <span class="script" style="color:var(--accent)">imaginations</span></h1>
        <p class="lead">Where little ones run the shops and grown-ups actually relax. Become a member for unlimited play in our cozy little downtown.</p>
        <div class="flex-cta center">
          <a class="btn btn--lg btn--pop btn--terracotta" href="/pages/memberships">Become a Member</a>
          <a class="btn btn--lg btn--ghost" href="/pages/play-pricing#pricing">Day Pass</a>
        </div>
      </div>
    </section>

    <!-- ============ EXPLORE THE TOWN (3 experiences) · beat 1 (colour wash) ============ -->
    <section class="section flow-top sec-color">
      <div class="container">
        <!-- Trust strip — the first thing under the hero. Quiet proof a parent
             scans before reading on. Every claim here is true of the space. -->
        <div class="trust-bar trust-bar--grid reveal" role="list" aria-label="Why families love Little Town" style="max-width:760px;margin-inline:auto;margin-bottom:clamp(2rem,4vw,3rem)">
          <span class="trust" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            Socks-only safe play floor
          </span>
          <span class="trust" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h13a3 3 0 0 1 0 6h-1"/><path d="M4 10v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1"/><path d="M7 7c.4-1 .4-1.7 0-2.6M11 7c.4-1 .4-1.7 0-2.6"/></svg>
            Gated parent lounge
          </span>
          <span class="trust" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20c.5-3.8 3.8-6 7.5-6s7 2.2 7.5 6"/></svg>
            Built for ages 2–7
          </span>
          <span class="trust" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 6"/></svg>
            Grown-ups always free
          </span>
        </div>
        <div class="center reveal">
          <span class="eyebrow">Welcome to Main Street</span>
          <h2>Explore our mini downtown</h2>
          <p class="section-lead">Every corner of Little Town is a tiny storefront waiting to be run by little hands.</p>
        </div>
        <div class="grid grid-3 mt-4 home-explore">
          <article class="card tilt-3d reveal pop-host">
            <span class="sticker sticker--sky home-card-sticker">Most loved</span>
            <span class="pop-bubble pop-bubble--sky" aria-hidden="true"><img src="{{ 'icon-slide.svg' | asset_url }}" alt="" width="22" height="22"></span>
            <div class="card-art"><img src="{{ 'logo-grocery.png' | asset_url }}" alt="The Little Town grocery storefront with its slide and tunnel." width="380" height="357" loading="lazy" decoding="async"></div>
            <h3>Open Play</h3>
            <p>Climb, slide and pretend through the grocery, the clinic and the corner café — soft, safe and sized just for little ones.</p>
            <a class="btn btn--ghost mt-1" href="/pages/play-pricing">Explore play</a>
          </article>
          <article class="card tilt-3d reveal pop-host" data-delay="1">
            <span class="sticker sticker--coral home-card-sticker">Buyouts</span>
            <span class="pop-bubble pop-bubble--coral" aria-hidden="true"><img src="{{ 'icon-balloon.svg' | asset_url }}" alt="" width="22" height="22"></span>
            <div class="card-art"><img src="{{ 'logo.png' | asset_url }}" alt="The whole Little Town — yours for a private party buyout." width="875" height="422" loading="lazy" decoding="async"></div>
            <h3>Private Parties</h3>
            <p>Rent the whole town for two hours, exclusively yours — bring your cake and decorations and make the day your own.</p>
            <a class="btn btn--ghost mt-1" href="/pages/parties">Plan a party</a>
          </article>
          <article class="card tilt-3d reveal pop-host" data-delay="2">
            <span class="sticker sticker--sage home-card-sticker">Next door</span>
            <span class="pop-bubble pop-bubble--sage" aria-hidden="true"><img src="{{ 'icon-coffee-cup.svg' | asset_url }}" alt="" width="22" height="22"></span>
            <div class="card-art"><img src="{{ 'logo-cafe.png' | asset_url }}" alt="The Little Town café tower, Fusion next door." width="156" height="373" loading="lazy" decoding="async"></div>
            <h3>Fusion</h3>
            <p>Our sister café Fusion pours fresh coffee and snacks — grab a cup before, during or after play.</p>
            <a class="btn btn--ghost mt-1" href="/pages/fusion">See Fusion</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ INSIDE THE TOWN — photo glimpse · beat 2 (dots) ============ -->
    <section class="section flow-top sec-dots has-bubbles home-glimpse-section">
      <span class="bubbles" aria-hidden="true"></span>
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">A peek inside</span>
          <h2>What it really <span class="hl hl--sky">looks like</span></h2>
          <p class="section-lead">The slides, the climbing wall, the giant foam blocks — the corners little ones make a beeline for the moment their socks are on.</p>
        </div>
        <div class="home-glimpse-grid mt-4 reveal" data-delay="1">
          <figure class="home-glimpse-tile home-glimpse-tile--feature">
            <picture>
              <source type="image/avif" srcset="{{ 'photo-play-bridge-600.avif' | asset_url }} 600w, {{ 'photo-play-bridge-900.avif' | asset_url }} 900w, {{ 'photo-play-bridge-1200.avif' | asset_url }} 1200w" sizes="(min-width: 700px) 48vw, 92vw">
              <source type="image/webp" srcset="{{ 'photo-play-bridge-600.webp' | asset_url }} 600w, {{ 'photo-play-bridge-900.webp' | asset_url }} 900w, {{ 'photo-play-bridge-1200.webp' | asset_url }} 1200w" sizes="(min-width: 700px) 48vw, 92vw">
              <img src="{{ 'photo-play-bridge.jpg' | asset_url }}" alt="A smiling child crossing the rope bridge." loading="lazy" decoding="async" style="object-position:center 28%">
            </picture>
            <figcaption><span class="glimpse-cap">The rope bridge</span></figcaption>
          </figure>
          <figure class="home-glimpse-tile">
            <picture>
              <source type="image/avif" srcset="{{ 'photo-play-climb-600.avif' | asset_url }} 600w, {{ 'photo-play-climb-900.avif' | asset_url }} 900w, {{ 'photo-play-climb-1200.avif' | asset_url }} 1200w" sizes="(min-width: 700px) 30vw, 92vw">
              <source type="image/webp" srcset="{{ 'photo-play-climb-600.webp' | asset_url }} 600w, {{ 'photo-play-climb-900.webp' | asset_url }} 900w, {{ 'photo-play-climb-1200.webp' | asset_url }} 1200w" sizes="(min-width: 700px) 30vw, 92vw">
              <img src="{{ 'photo-play-climb.jpg' | asset_url }}" alt="A child climbing the colorful rock wall." loading="lazy" decoding="async" style="object-position:center 35%">
            </picture>
            <figcaption><span class="glimpse-cap">The climbing wall</span></figcaption>
          </figure>
          <figure class="home-glimpse-tile">
            <picture>
              <source type="image/avif" srcset="{{ 'photo-play-slide-600.avif' | asset_url }} 600w, {{ 'photo-play-slide-900.avif' | asset_url }} 900w, {{ 'photo-play-slide-1200.avif' | asset_url }} 1200w" sizes="(min-width: 700px) 30vw, 92vw">
              <source type="image/webp" srcset="{{ 'photo-play-slide-600.webp' | asset_url }} 600w, {{ 'photo-play-slide-900.webp' | asset_url }} 900w, {{ 'photo-play-slide-1200.webp' | asset_url }} 1200w" sizes="(min-width: 700px) 30vw, 92vw">
              <img src="{{ 'photo-play-slide.jpg' | asset_url }}" alt="The bright slides above the ball pit at Little Town." loading="lazy" decoding="async">
            </picture>
            <figcaption><span class="glimpse-cap">Slides &amp; ball pit</span></figcaption>
          </figure>
          <figure class="home-glimpse-tile home-glimpse-tile--wide">
            <picture>
              <source type="image/avif" srcset="{{ 'photo-play-blocks-600.avif' | asset_url }} 600w, {{ 'photo-play-blocks-900.avif' | asset_url }} 900w, {{ 'photo-play-blocks-1200.avif' | asset_url }} 1200w" sizes="(min-width: 700px) 48vw, 92vw">
              <source type="image/webp" srcset="{{ 'photo-play-blocks-600.webp' | asset_url }} 600w, {{ 'photo-play-blocks-900.webp' | asset_url }} 900w, {{ 'photo-play-blocks-1200.webp' | asset_url }} 1200w" sizes="(min-width: 700px) 48vw, 92vw">
              <img src="{{ 'photo-play-blocks.jpg' | asset_url }}" alt="A child building inside a fort of giant foam blocks." loading="lazy" decoding="async" style="object-position:center 38%">
            </picture>
            <figcaption><span class="glimpse-cap">Giant foam blocks</span></figcaption>
          </figure>
        </div>
        <p class="glimpse-note center">A peek at the play floor — slides, climbing wall and giant foam blocks.</p>
        <p class="center mt-2"><a class="btn btn--ghost" href="/pages/photo-gallery">See the full gallery</a></p>
      </div>
    </section>

    <!-- ============ HOW A VISIT WORKS (numbered steps) · beat 3 (calm) ============ -->
    <section class="section home-steps flow-top sec-calm">
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Easy as one, two, three</span>
          <h2>How a visit works</h2>
          <p class="section-lead">No fuss, no booking gymnastics — just stop in and play.</p>
        </div>
        <div class="steps mt-4">
          <div class="step reveal pop">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Come on in, socks on</h3>
            <p>Already paid online or a member? Just walk straight in, swap shoes for socks (everyone in your party), and you're playing in a minute.</p>
          </div>
          <div class="step reveal pop" data-delay="1">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Run the little town</h3>
            <p>Little ones take over the shops, the clinic and the slides while you settle into the gated parent lounge with a clear view of the floor.</p>
          </div>
          <div class="step reveal pop" data-delay="2">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Coffee at Fusion</h3>
            <p>Slip next door to Fusion for a real coffee and a snack while the little ones keep playing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PARENT REASSURANCE · beat 4 (playful: colour wash + dots) ============ -->
    <section class="section flow-top sec-play has-bubbles">
      <span class="bubbles" aria-hidden="true"></span>
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Parents, you can relax</span>
          <h2>Safe, comfy, <span class="hl">easy</span></h2>
        </div>

        <!-- Featured: the gated parent lounge — the star of this section. It
             sits right at the entrance, gated off from the play floor, so
             grown-ups get a calm spot with a Fusion coffee and clear sightlines.
             Leads the trio of reassurance cards below. -->
        <div class="lounge-feature reveal mt-4">
          <div class="lounge-feature-copy">
            <span class="lounge-flag"><img src="{{ 'icon-coffee-cup.svg' | asset_url }}" alt="" width="16" height="16"> Right inside the door</span>
            <span class="eyebrow">The Parent Lounge</span>
            <h3 class="lounge-title">A lounge that's <span class="script" style="color:var(--accent)">all yours</span></h3>
            <p>The moment you walk in there's a gated lounge just for grown-ups — sink into comfy seating with a Fusion coffee in hand and keep a clear eye on the play floor through the gate. Close enough to watch, calm enough to actually relax.</p>
            <ul class="lounge-perks">
              <li>Gated off from the play floor — grown-ups only</li>
              <li>Sip a Fusion coffee while the little ones play</li>
              <li>Comfy seats with clear sightlines across the floor</li>
            </ul>
          </div>
          <div class="lounge-feature-art" aria-hidden="true">
            <svg class="lounge-card" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="10" width="308" height="240" rx="22" fill="#ffffff" stroke="#e6dfd1" stroke-width="2"/>
              <clipPath id="loungeClip"><rect x="20" y="24" width="280" height="170" rx="14"/></clipPath>
              <g clip-path="url(#loungeClip)">
                <!-- two zones: warm lounge on the left, sky-toned play floor on the right -->
                <rect x="20" y="24" width="280" height="170" fill="#f7eee1"/>
                <rect x="206" y="24" width="94" height="170" fill="#e3f1f6"/>
                <rect x="20" y="150" width="280" height="44" fill="#efe2cf"/>
                <rect x="206" y="150" width="94" height="44" fill="#d6e9ef"/>
                <!-- rug under the armchair -->
                <ellipse cx="96" cy="158" rx="76" ry="12" fill="#f2d9bf"/>
                <!-- armchair -->
                <ellipse cx="92" cy="156" rx="54" ry="8" fill="#3a2c20" opacity="0.10"/>
                <rect x="56" y="78" width="74" height="62" rx="18" fill="#E0A184" stroke="#C2805F" stroke-width="2.5"/>
                <rect x="46" y="104" width="20" height="44" rx="10" fill="#D98F70" stroke="#C2805F" stroke-width="2.5"/>
                <rect x="120" y="104" width="20" height="44" rx="10" fill="#D98F70" stroke="#C2805F" stroke-width="2.5"/>
                <rect x="52" y="116" width="82" height="30" rx="12" fill="#E9B59C" stroke="#C2805F" stroke-width="2.5"/>
                <rect x="72" y="90" width="34" height="30" rx="9" fill="#F8D98F" stroke="#E3B85C" stroke-width="2" transform="rotate(-6 89 105)"/>
                <!-- side table + steaming Fusion coffee -->
                <ellipse cx="162" cy="150" rx="20" ry="6" fill="#caa97f"/>
                <rect x="158" y="128" width="8" height="22" fill="#b98f5f"/>
                <ellipse cx="162" cy="128" rx="20" ry="6.5" fill="#d9b98a" stroke="#a9824f" stroke-width="2"/>
                <g stroke="#8A5A2C" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5">
                  <path d="M157 116 q-4 -6 0 -12"/>
                  <path d="M167 114 q-4 -6 0 -12"/>
                </g>
                <path d="M150 118 h22 l-2 12 q-1 6 -9 6 q-8 0 -9 -6 Z" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2.2" stroke-linejoin="round"/>
                <path d="M172 120 q9 0 9 7 q0 7 -9 7" fill="none" stroke="#8A5A2C" stroke-width="2.2"/>
                <ellipse cx="161" cy="118" rx="11" ry="3" fill="#8A5A2C"/>
                <!-- the gate: a low panel that fences the lounge off from the play floor -->
                <rect x="186" y="112" width="40" height="80" rx="8" fill="#ffffff" stroke="#cdbfa6" stroke-width="2.5"/>
                <g stroke="#cdbfa6" stroke-width="3" stroke-linecap="round">
                  <line x1="196" y1="120" x2="196" y2="184"/>
                  <line x1="206" y1="120" x2="206" y2="184"/>
                  <line x1="216" y1="120" x2="216" y2="184"/>
                </g>
                <rect x="184" y="126" width="44" height="6" rx="3" fill="#BFD6A8" stroke="#9bb583" stroke-width="1.5"/>
                <rect x="184" y="160" width="44" height="6" rx="3" fill="#BFD6A8" stroke="#9bb583" stroke-width="1.5"/>
                <circle cx="224" cy="149" r="3.5" fill="#D9663D"/>
                <!-- a glimpse of the play floor through the gate: slide + ball -->
                <line x1="248" y1="116" x2="248" y2="150" stroke="#2F8AA6" stroke-width="4" stroke-linecap="round"/>
                <g stroke="#F8D98F" stroke-width="3" stroke-linecap="round">
                  <line x1="243" y1="126" x2="253" y2="126"/>
                  <line x1="243" y1="138" x2="253" y2="138"/>
                </g>
                <path d="M248 116 q24 2 40 34" fill="none" stroke="#AEDCEA" stroke-width="9" stroke-linecap="round"/>
                <path d="M248 116 q24 2 40 34" fill="none" stroke="#7fc6dc" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
                <circle cx="262" cy="161" r="9" fill="#F4AE92" stroke="#d98f70" stroke-width="2"/>
                <path d="M253 161 h18 M262 152 v18" stroke="#fff" stroke-width="1.5" opacity="0.85"/>
              </g>
              <rect x="58" y="206" width="204" height="30" rx="15" fill="#f3ead9"/>
              <text x="160" y="226" text-anchor="middle" font-family="Quicksand, system-ui, sans-serif" font-weight="700" font-size="13" fill="#3F7268">Parents' Lounge · gated off</text>
            </svg>
          </div>
        </div>

        <div class="grid grid-3 mt-4">
          <div class="reassure reveal">
            <div class="chip"><img src="{{ 'icon-safe.svg' | asset_url }}" alt="" width="38" height="38" loading="lazy" decoding="async"></div>
            <h3>Safe &amp; Secure</h3>
            <p>Soft, padded play zones and a secure one-way-in, one-way-out gate, so little explorers stay safe and sound.</p>
          </div>
          <div class="reassure reveal" data-delay="1">
            <div class="chip" style="background:var(--wood-tint)"><img src="{{ 'icon-coffee-cup.svg' | asset_url }}" alt="" width="38" height="38" loading="lazy" decoding="async"></div>
            <h3>Grown-Up Lounge</h3>
            <p>Settle into the gated lounge by the entrance with a Fusion coffee and clear sightlines to the play floor — relax while the little ones run the town.</p>
          </div>
          <div class="reassure reveal" data-delay="2">
            <div class="chip" style="background:var(--terra-tint)"><img src="{{ 'icon-baby.svg' | asset_url }}" alt="" width="38" height="38" loading="lazy" decoding="async"></div>
            <h3>Little Ones Welcome</h3>
            <p>Pint-sized storefronts and soft, secure play zones designed for ages 2–7 — every corner built for little hands to explore.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MEMBERSHIP BAND (main offer) · beat 5 (colour wash) ============ -->
    <section class="section flow-top sec-color">
      <div class="container">
        <div class="member-band home-member reveal">
          <!-- Soft floater adds a brand touch in the band's empty top-right corner (desktop only) -->
          <span class="hm-deco hm-deco--star anim-twinkle" aria-hidden="true"><img src="{{ 'deco-star.svg' | asset_url }}" alt="" width="34" height="34"></span>
          <div class="home-member-copy">
            <span class="member-flag"><img src="{{ 'icon-star.svg' | asset_url }}" alt="" width="14" height="14"> Best value membership</span>
            <span class="eyebrow">Membership · the heart of Little Town</span>
            <h2>Unlimited play, <span class="script">all month</span> long</h2>
            <p>For less than the price of a few day passes a month, your little one gets the run of the whole town whenever the mood strikes — rain or shine.</p>
            <ul class="price-list member-perks" style="max-width:460px">
              <li>Unlimited open play, every day we're open</li>
              <li>Grown-ups always get in free</li>
              <li>Come &amp; go all day — same-day re-entry</li>
            </ul>
            <div class="flex-cta">
              <a class="btn btn--lg btn--pop btn--onfill" href="/pages/memberships">Join the club</a>
              <a class="btn btn--lg btn--ghost" style="color:var(--ink);border-color:rgba(58,49,40,0.28)" href="/pages/memberships#tiers">Compare tiers</a>
            </div>
          </div>
          <div class="member-art">
            <div class="member-photo pop-host">
              <span class="pop-bubble" aria-hidden="true"><img src="{{ 'icon-heart.svg' | asset_url }}" alt="" width="22" height="22"></span>
              <!-- Placeholder photo (Unsplash, free license) — swap for your own play-floor shots later -->
              <picture>
                <source type="image/avif" srcset="{{ 'photo-play-bridge-600.avif' | asset_url }} 600w, {{ 'photo-play-bridge-900.avif' | asset_url }} 900w, {{ 'photo-play-bridge-1200.avif' | asset_url }} 1200w" sizes="(min-width: 860px) 45vw, 92vw">
                <source type="image/webp" srcset="{{ 'photo-play-bridge-600.webp' | asset_url }} 600w, {{ 'photo-play-bridge-900.webp' | asset_url }} 900w, {{ 'photo-play-bridge-1200.webp' | asset_url }} 1200w" sizes="(min-width: 860px) 45vw, 92vw">
                <img src="{{ 'photo-play-bridge.jpg' | asset_url }}" alt="A child balancing across a rope bridge inside the soft-play structure." width="1000" height="800" loading="lazy" decoding="async" style="aspect-ratio:5/4;object-fit:cover;object-position:center 30%">
              </picture>
            </div>
            <p class="member-price"><small>from</small><b>$40</b><small>a&nbsp;month</small></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRICING (membership featured) · beat 6 (dots) ============ -->
    <section class="section flow-top sec-dots has-bubbles">
      <span class="bubbles" aria-hidden="true"></span>
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Simple, friendly pricing</span>
          <h2>Pick your play</h2>
          <p class="section-lead">No hidden fees. Grown-ups always get in free with a paid little one — and members play unlimited.</p>
        </div>
        <div class="cp-grid cp-grid--2">

          <!-- Day Pass — child-count tiers in the dropdown -->
          <article class="cp-card reveal" aria-label="Day Pass pricing">
            <span class="cp-icon cp-icon--sky" aria-hidden="true"><img src="{{ 'icon-slide.svg' | asset_url }}" alt="" width="26" height="26"></span>
            <h3 class="cp-name">Day Pass</h3>
            <p class="cp-blurb">One-time visit, all-day play. Siblings share one pass — just pick your group size.</p>
            <div class="cp-price">
              <span class="cp-price-amount" data-daypass-price>$10</span>
              <span class="cp-price-unit" data-daypass-unit>for 1 child</span>
            </div>
            <div class="cp-tier">
              <label class="cp-tier-label" for="daypass-tier-home">How many children?</label>
              <select class="cp-tier-select" id="daypass-tier-home" data-daypass-select aria-label="Choose how many children">
                <option value="1" data-daypass-opt="1" data-price="$10" data-unit="for 1 child" data-href="{%- if dp_v1 != blank -%}/cart/{{ dp_v1.id }}:1{%- endif -%}">1 child — $10</option>
                <option value="2" data-daypass-opt="2" data-price="$18" data-unit="for 2 children" data-href="{%- if dp_v2 != blank -%}/cart/{{ dp_v2.id }}:1{%- endif -%}">2 children — $18</option>
                <option value="3" data-daypass-opt="3" data-price="$25" data-unit="for 3+ children" data-href="{%- if dp_v3 != blank -%}/cart/{{ dp_v3.id }}:1{%- endif -%}">3 or more children — $25</option>
              </select>
            </div>
            <ul class="cp-list">
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>All-day open play</li>
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>One pass covers every sibling</li>
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Grown-ups always free</li>
            </ul>
            <a class="cp-cta" data-daypass-buy href="/products/day-pass" data-buy-href="{%- if dp_v1 != blank -%}/cart/{{ dp_v1.id }}:1{%- endif -%}">Buy Day Pass</a>
          </article>

          <!-- Membership (featured) -->
          <article class="cp-card cp-card--featured reveal" data-delay="1" aria-label="Membership — most popular">
            <span class="cp-popular">Most popular!</span>
            <span class="cp-icon" aria-hidden="true"><img src="{{ 'icon-star.svg' | asset_url }}" alt="" width="26" height="26"></span>
            <h3 class="cp-name">Membership</h3>
            <p class="cp-blurb">Unlimited play for the regulars — the best deal.</p>
            <div class="cp-price">
              <span class="cp-price-amount">$40</span>
              <span class="cp-price-unit">/ month</span>
            </div>
            <ul class="cp-list">
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Unlimited open play</li>
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Grown-ups always free</li>
              <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Same-day re-entry</li>
            </ul>
            <a class="cp-cta" href="/pages/memberships">Choose Membership</a>
          </article>

        </div>
      </div>
    </section>

    <!-- Street-ground motif leads into the closing call to action -->
    <div class="street-divider" aria-hidden="true"><img src="{{ 'street-divider.svg' | asset_url }}" alt="" width="1440" height="120" loading="lazy" decoding="async"></div>

    <!-- ============ NEWSLETTER ============ -->
    <section class="section">
      <div class="container">
        <div class="newsletter reveal anim-gradient">
          <span class="eyebrow" style="color:var(--accent)">Stay in the loop</span>
          <h2>Little news from the little town</h2>
          <p>Seasonal events, new arrivals and the odd free-play day — straight to your inbox.</p>
          {% form 'customer', class: 'newsletter-form' %}{%- if form.posted_successfully? -%}<p style="color:#fff;font-weight:600;margin:0">Thanks — you're on the list! 🎉</p>{%- else -%}<input type="hidden" name="contact[tags]" value="newsletter"><label for="nl-email" style="position:absolute;left:-9999px">Email address</label><input id="nl-email" type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required><button class="btn" type="submit" style="background:#fff;color:var(--accent)">Subscribe</button>{%- endif -%}{% endform %}
        </div>
      </div>
    </section>
  </main>
