            <figcaption>The climbing wall</figcaption>
          </figure>
          <figure class="pp-glimpse-tile">
            <img src="{{ 'photo-play-blocks.jpg' | asset_url }}" alt="A child building inside a fort of giant foam blocks." loading="lazy" decoding="async" style="object-position:center 40%">
            <figcaption>Giant foam blocks</figcaption>
          </figure>
          <figure class="pp-glimpse-tile">
