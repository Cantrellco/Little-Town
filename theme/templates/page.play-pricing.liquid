    <!-- ===================== PRICING — lead with the offer ===================== -->
    <!-- flow-top: the wave divider that rises out of the hero on every page -->
    <section class="pricing-section band has-bubbles flow-top" id="pricing">
      <span class="bubbles" aria-hidden="true"></span>
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Open-play pricing</span>
          <h2>Pay as you <span class="hl">play</span></h2>
          <p class="section-lead">One paid child brings one free grown-up. Socks only on the play floor, no shoes — for kids and grown-ups alike.</p>
        </div>

        <div class="price-cards-wrap">

          <!-- Day Pass -->
          <article class="pp-price-card reveal" aria-label="Day Pass pricing">
            <div class="pp-card-art">
              <img src="{{ 'price-daypass.svg' | asset_url }}" alt="Day pass ticket illustration." width="200" height="140" loading="lazy" decoding="async">
            </div>
            <h3>Day Pass</h3>
            <div class="pp-price-tag">$18 <small>/ child</small></div>
            <ul class="pp-price-list">
              <li>All-day open play with re-entry</li>
              <li>One free grown-up per child</li>
              <li>Infants under 1 play free</li>
              <li>Extra siblings just $14 each</li>
            </ul>
            <a class="btn btn--block btn--terracotta btn--pop" href="/products/day-pass">Buy Day Pass</a>
          </article>

          <!-- Play Pack (featured) -->
          <article class="pp-price-card featured reveal" data-delay="1" aria-label="Play Pack pricing — best value">
            <span class="pp-sticker" aria-label="Best value">⭐ Best value</span>
            <div class="pp-card-art" style="background:var(--sun-tint)">
              <img src="{{ 'price-playpack.svg' | asset_url }}" alt="Five-visit play pack illustration." width="200" height="140" loading="lazy" decoding="async">
            </div>
            <h3>Play Pack</h3>
            <div class="pp-price-tag">$75 <small>/ 5 visits</small></div>
            <ul class="pp-price-list">
              <li>Five all-day passes</li>
              <li>Better value than day passes</li>
              <li>Shareable between siblings</li>
              <li>Never expires</li>
            </ul>
            <a class="btn btn--block btn--sun btn--pop" href="/products/play-pack">Buy Play Pack</a>
          </article>

        </div>
      </div>
    </section>

    <!-- ===================== INSIDE THE TOWN — photo glimpse ===================== -->
