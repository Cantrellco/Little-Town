            <article class="cp-card reveal" aria-label="1 Child Monthly plan">
              <span class="cp-icon cp-icon--sky" aria-hidden="true"><img src="{{ 'icon-baby.svg' | asset_url }}" alt="" width="26" height="26"></span>
              <h4 class="cp-name">1 Child</h4>
              <p class="cp-blurb">Perfect for one little adventurer.</p>
              <div class="cp-price">
                <span class="cp-price-amount">$40</span>
                <span class="cp-price-unit">/ month</span>
              </div>
              <ul class="cp-list">
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Unlimited open play, every day we're open</li>
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Grown-ups always free</li>
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Cancel anytime</li>
              </ul>
              {%- assign _v = blank -%}{%- if monthly_prod != blank -%}{%- for v in monthly_prod.variants -%}{%- if v.title contains '1 Child' -%}{%- assign _v = v -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- if _v == blank -%}{%- assign _v = monthly_prod.variants[0] -%}{%- endif -%}{%- endif -%}<a class="cp-cta" href="{%- if _v != blank -%}/cart/{{ _v.id }}:1{%- if m_plan != blank %}?selling_plan={{ m_plan }}{%- endif -%}{%- else -%}/products/monthly-membership{%- endif -%}">Join Monthly</a>
            </article>

            <!-- 2 Children Monthly — MOST POPULAR -->
            <article class="cp-card cp-card--featured reveal" data-delay="1" aria-label="2 Children Monthly plan — most popular">
              <span class="cp-popular">Most popular!</span>
              <span class="cp-icon" aria-hidden="true"><img src="{{ 'icon-heart.svg' | asset_url }}" alt="" width="26" height="26"></span>
              <h4 class="cp-name">2 Children</h4>
              <p class="cp-blurb">Two siblings, one easy plan — most families pick this one.</p>
              <div class="cp-price">
                <span class="cp-price-amount">$60</span>
                <span class="cp-price-unit">/ month</span>
              </div>
              <ul class="cp-list">
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Unlimited open play for both kids</li>
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Grown-ups always free</li>
                <li><span class="cp-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Cancel anytime</li>
              </ul>
              {%- assign _v = blank -%}{%- if monthly_prod != blank -%}{%- for v in monthly_prod.variants -%}{%- if v.title contains '2 Children' -%}{%- assign _v = v -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- if _v == blank -%}{%- assign _v = monthly_prod.variants[1] -%}{%- endif -%}{%- endif -%}<a class="cp-cta" href="{%- if _v != blank -%}/cart/{{ _v.id }}:1{%- if m_plan != blank %}?selling_plan={{ m_plan }}{%- endif -%}{%- else -%}/products/monthly-membership{%- endif -%}">Join Monthly</a>
