<main>

    <!-- ============================================================
         HERO — same recipe as Fusion: a single signature tile (map pins)
         on a cool teal→meadow gradient, with the mini location card beside
         the copy.
         ============================================================ -->
    <section class="page-hero ph--visit">

      <div class="container">

        <div class="reveal">
          <span class="partner-tag"><img src="{{ 'icon-pin.svg' | asset_url }}" alt="" width="18" height="18"> Visit us · Riverbend</span>
          <h1 style="margin-top:0.8rem">Come <span class="hl hl--sky">play</span> in our <span class="script" style="color:var(--accent)">little town</span></h1>
          <p class="lead"><strong class="hl--sky" style="color:var(--ink)">Right on Main Street in Riverbend.</strong> Drop in whenever you're ready — we'd love to have you.</p>

          <div class="pill-row">
            <span class="pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="display:inline;vertical-align:-2px;margin-right:3px"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              12 Main Street, Riverbend
            </span>
            <span class="pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="display:inline;vertical-align:-2px;margin-right:3px"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l2 2"/></svg>
              Open 7 days
            </span>
          </div>

          <div class="flex-cta">
            <a class="btn btn--lg btn--terracotta btn--pop" href="#contact">Say hello</a>
            <a class="btn btn--lg btn--ghost" href="/pages/memberships">See membership plans</a>
          </div>
        </div>

        <!-- Art column: a friendly location card — a mini map with our pin on it -->
        <div class="visit-hero-art reveal" data-delay="1">
            <svg class="visit-loc-card" viewBox="0 0 300 240" role="img" aria-label="A map card showing the Little Town location pin at 12 Main Street." xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="10" width="288" height="222" rx="22" fill="#ffffff" stroke="#e6dfd1" stroke-width="2"/>
              <clipPath id="visitMapClip"><rect x="20" y="24" width="260" height="158" rx="14"/></clipPath>
              <g clip-path="url(#visitMapClip)">
                <rect x="20" y="24" width="260" height="158" fill="#dcEEE6"/>
                <g stroke="#c2dccf" stroke-width="7">
                  <line x1="20" y1="72" x2="280" y2="72"/>
                  <line x1="20" y1="132" x2="280" y2="132"/>
                  <line x1="108" y1="24" x2="108" y2="182"/>
                  <line x1="204" y1="24" x2="204" y2="182"/>
                </g>
                <path d="M30 168 C 92 168 92 100 152 100 S 244 64 274 64" fill="none" stroke="#C2805F" stroke-width="3" stroke-dasharray="0.5 12" stroke-linecap="round" opacity="0.8"/>
              </g>
              <g transform="translate(152,52)">
                <ellipse cx="0" cy="56" rx="15" ry="5" fill="#3F7268" opacity="0.18"/>
                <path d="M0 55 C -12 33 -20 23 -20 12 a 20 20 0 1 1 40 0 c 0 11 -8 21 -20 43 Z" fill="#E0A184" stroke="#C2805F" stroke-width="2.5"/>
                <circle cx="0" cy="12" r="8.5" fill="#ffffff"/>
              </g>
              <rect x="66" y="196" width="168" height="28" rx="14" fill="#f3ead9"/>
              <text x="150" y="215" text-anchor="middle" font-family="Quicksand, system-ui, sans-serif" font-weight="700" font-size="13" fill="#3F7268">12 Main Street</text>
            </svg>
          </div>
      </div>
    </section>

    <!-- ============================================================
         HOURS + MAP — lively hours card, map with sticker cluster
         flow-top: the wave divider that rises out of the hero on every page
         ============================================================ -->
    <section class="section flow-top">
      <div class="container split">

        <!-- LEFT: hours + contact details -->
        <div class="reveal">
          <span class="eyebrow">Opening hours</span>
          <h2>When we're <span class="hl">open</span></h2>

          <!-- Hours card -->
          <div class="hours-card" style="max-width:420px" role="region" aria-label="Opening hours">
            <div class="hours-card-header">
              <!-- Clock icon -->
              <svg class="clock-icon" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l3.5 3.5"/></svg>
              <h3>Our hours</h3>
            </div>
            <div class="hours-body">
              <!-- JS adds .is-today to the matching row; degrades gracefully (all rows visible) -->
              <div class="hours-row" data-days="1,2,3,4">
                <span class="hours-day">Mon – Thu<span class="today-badge" aria-label="Open today">Today</span></span>
                <span class="hours-time">9:00am – 6:00pm</span>
              </div>
              <div class="hours-row" data-days="5">
                <span class="hours-day">Friday<span class="today-badge" aria-label="Open today">Today</span></span>
                <span class="hours-time">9:00am – 8:00pm</span>
              </div>
              <div class="hours-row" data-days="6">
                <span class="hours-day">Saturday<span class="today-badge" aria-label="Open today">Today</span></span>
                <span class="hours-time">9:00am – 8:00pm</span>
              </div>
              <div class="hours-row" data-days="0">
                <span class="hours-day">Sunday<span class="today-badge" aria-label="Open today">Today</span></span>
                <span class="hours-time">10:00am – 5:00pm</span>
              </div>
            </div>
          </div>

          <!-- Contact details beneath the card -->
          <div class="contact-details mt-3">
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="contact-detail-copy">
                <strong>Address</strong>
                <span>12 Main Street, Riverbend, CA 90210</span>
              </div>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 3.08 4.18 2 2 0 0 1 5.06 2h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.87a2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.21-1.21a2 2 0 0 1 2.11-.45c.91.35 1.87.59 2.87.72A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="contact-detail-copy">
                <strong>Phone</strong>
                <a href="#" data-noop>(555) 014-2025</a>
              </div>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="contact-detail-copy">
                <strong>Email</strong>
                <a href="#" data-noop>hello@littletownplay.com</a>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: map + sticker cluster -->
        <div class="reveal" data-delay="1">
          <div class="map-frame pop-host">
            <span class="pop-bubble pop-bubble--coral" aria-hidden="true"><img src="{{ 'icon-pin.svg' | asset_url }}" alt="" width="22" height="22"></span>
            <!-- map-light.svg is auto-inlined + animated by main.js; keep filename -->
            <div class="map-light">
              <img src="{{ 'map-light.svg' | asset_url }}" alt="Stylized illustrated map showing Little Town Playhouse on Main Street, Riverbend." width="600" height="380" loading="lazy" decoding="async">
            </div>
          </div>
          <p class="mock-note">Illustrated map placeholder — a live, interactive map would be embedded here.</p>

          <!-- Sticker cluster — wayfinding quick-facts -->
          <div class="map-stickers" aria-label="Visitor quick-facts">
            <span class="sticker sticker--sage hover-jelly">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              Step-free access
            </span>
            <span class="sticker hover-jelly">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
              Strollers welcome
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- ============================================================
         PLAN YOUR VISIT — 3-step numbered guide
         ============================================================ -->
    <section class="section visit-steps-section flow-top has-bubbles">
      <span class="bubbles" aria-hidden="true"></span>
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Getting here</span>
          <h2>Plan your <span class="hl hl--sky">visit</span></h2>
          <p class="section-lead">Three easy steps to a great day out.</p>
        </div>

        <div class="steps visit-steps mt-4 reveal" data-delay="1">
          <div class="step">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Stop in</h3>
            <p>No booking needed for open play — paid online or a member? Just show up and walk straight in. Need a pass or a hand? Fusion next door has you covered.</p>
          </div>
          <div class="step">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Socks on, shoes off</h3>
            <p>Everyone on the play floor needs to be in socks — no shoes please. Bring a clean pair for each little one and grown-up.</p>
          </div>
          <div class="step">
            <div class="step-no" aria-hidden="true"></div>
            <h3>Play the town!</h3>
            <p>Explore the market, bakery, fire station and more. Parents relax — Fusion coffee is right next door.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ============================================================
         CONTACT — simple, two-channel "Contact us for more info"
         ============================================================ -->
    <section class="section band flow-top" id="contact">
      <div class="container" style="max-width:760px">

        <div class="center reveal">
          <span class="eyebrow">Need more info?</span>
          <h2>Contact <span class="hl hl--coral">us</span></h2>
          <p class="section-lead">Questions about visiting, parties or memberships? Give us a ring or drop an email — we usually reply the same day.</p>
        </div>

        <div class="contact-quick reveal mt-4">
          <a class="contact-quick-card tilt-3d" href="tel:+15550142025">
            <span class="contact-quick-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 3.08 4.18 2 2 0 0 1 5.06 2h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.87a2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.21-1.21a2 2 0 0 1 2.11-.45c.91.35 1.87.59 2.87.72A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span class="contact-quick-copy">
              <span class="contact-quick-label">Call us</span>
              <strong>(555) 014-2025</strong>
              <small>Open hours, every play day</small>
            </span>
          </a>
          <a class="contact-quick-card tilt-3d" href="mailto:hello@littletownplay.com">
            <span class="contact-quick-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <span class="contact-quick-copy">
              <span class="contact-quick-label">Email us</span>
              <strong>hello@littletownplay.com</strong>
              <small>For parties &amp; bigger plans</small>
            </span>
          </a>
        </div>

        <p class="mock-note" style="margin-top:1.25rem">Prefer to swing by? We're at 12 Main Street — stop in anytime we're open.</p>

      </div>
    </section>

    <!-- ============================================================
         VISITOR FAQ — accordion, all 4 Q&As intact
         ============================================================ -->
    <section class="section visit-faq-section">
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Before you come</span>
          <h2>Visitor <span class="hl">FAQ</span></h2>
          <p class="section-lead" style="max-width:48ch">Everything you need to know before your first visit.</p>
        </div>

        <div class="accordion mt-4">
          <div class="acc-item reveal" aria-expanded="true">
            <button class="acc-trigger" aria-expanded="true">
              Do I need to book ahead for open play?
              <span class="acc-icon" aria-hidden="true">+</span>
            </button>
            <div class="acc-panel">
              <div>
                <p>Open play is walk-in friendly. On busy weekends and school breaks we may reach capacity, so members and guests who reserve ahead get priority entry.</p>
              </div>
            </div>
          </div>

          <div class="acc-item reveal" aria-expanded="false">
            <button class="acc-trigger" aria-expanded="false">
              What should we bring?
              <span class="acc-icon" aria-hidden="true">+</span>
            </button>
            <div class="acc-panel">
              <div>
                <p>Just socks for everyone heading onto the play floor — no shoes please. We have changing facilities, a nursing corner and lockers on-site.</p>
              </div>
            </div>
          </div>

          <div class="acc-item reveal" aria-expanded="false">
            <button class="acc-trigger" aria-expanded="false">
              Is the space accessible?
              <span class="acc-icon" aria-hidden="true">+</span>
            </button>
            <div class="acc-panel">
              <div>
                <p>Absolutely. The whole town is step-free with wide pathways, an accessible restroom, and quiet hours on Wednesday mornings for families who prefer a calmer visit.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CLOSING CTA BAND — sky/teal gradient, warm send-off
         ============================================================ -->
    <section class="section flow-top">
      <div class="container">
        <div class="visit-cta-band reveal anim-gradient">
          <span class="eyebrow on-dark">Ready for an adventure?</span>
          <h2>We'll see you <span class="script" style="color:var(--accent)">in town!</span></h2>
          <p style="max-width:42ch;margin-inline:auto">No booking needed for open play — just show up, swap shoes for socks, and let the fun begin.</p>
          <div class="flex-cta center">
            <a class="btn btn--lg btn--sun btn--pop" href="/pages/play-pricing">See play &amp; pricing</a>
            <a class="btn btn--lg btn--ghost" href="/pages/memberships">Become a Member</a>
          </div>
        </div>
      </div>
    </section>

  </main>
