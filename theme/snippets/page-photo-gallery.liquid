          <button type="button" class="lt-car-arrow lt-car-arrow--prev" data-dir="-1" aria-label="Previous photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="lt-car-arrow lt-car-arrow--next" data-dir="1" aria-label="Next photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="lt-car-foot">
            <div class="lt-car-dots" role="tablist" aria-label="Choose a photo">
                <button type="button" class="lt-car-dot" data-go="0" aria-label="Show photo 1: The whole little town" aria-current="true"></button>
                <button type="button" class="lt-car-dot" data-go="1" aria-label="Show photo 2: The play castle"></button>
                <button type="button" class="lt-car-dot" data-go="2" aria-label="Show photo 3: The big slides"></button>
                <button type="button" class="lt-car-dot" data-go="3" aria-label="Show photo 4: Climbing the towers"></button>
                <button type="button" class="lt-car-dot" data-go="4" aria-label="Show photo 5: The little clinic"></button>
                <button type="button" class="lt-car-dot" data-go="5" aria-label="Show photo 6: The little grocery"></button>
                <button type="button" class="lt-car-dot" data-go="6" aria-label="Show photo 7: The little market"></button>
                <button type="button" class="lt-car-dot" data-go="7" aria-label="Show photo 8: Behind the register"></button>
                <button type="button" class="lt-car-dot" data-go="8" aria-label="Show photo 9: Little chefs at work"></button>
                <button type="button" class="lt-car-dot" data-go="9" aria-label="Show photo 10: The play kitchen"></button>
                <button type="button" class="lt-car-dot" data-go="10" aria-label="Show photo 11: Coffee with a view of play"></button>
