<main>

    <!-- ===================== PAGE HERO — same recipe as Fusion: a single
         signature tile (cameras) on a warm peach gradient, with the polaroid
         stack beside the copy. ===================================== -->
    <section class="page-hero ph--gallery">

      <div class="container">
        <div class="gallery-hero-inner">

          <!-- Copy column -->
          <div class="reveal">
            <span class="partner-tag"><img src="{{ 'icon-camera.svg' | asset_url }}" alt="" width="18" height="18"> Captured moments</span>
            <h1 style="margin-top:0.8rem">Snapshots from <span class="script" style="color:var(--accent)">the little town</span></h1>
            <p class="lead"><strong class="hl--coral" style="color:var(--ink)">Real days, real smiles.</strong> A peek at what an afternoon at Little Town actually looks like &#x2014; tiny baristas, big imaginations, and the in-between moments we love most.</p>
            <div class="flex-cta">
              <a class="btn btn--lg btn--terracotta btn--pop" href="#gallery">See the gallery &#x2193;</a>
              <a class="btn btn--lg btn--ghost" href="/pages/visit-us">Plan a visit</a>
            </div>
          </div>

          <!-- Art column: a polished polaroid stack -->
          <div class="gallery-hero-art reveal" data-delay="1" style="max-width:340px">
            <svg viewBox="0 0 320 280" role="img" aria-labelledby="galleryArtTitle" xmlns="http://www.w3.org/2000/svg">
              <title id="galleryArtTitle">A stack of polaroid photos from the playhouse.</title>

              <!-- soft cast shadow under the stack -->
              <ellipse cx="160" cy="262" rx="120" ry="6" fill="#3a2c20" opacity="0.16"/>

              <!-- back polaroid (sage, tilted left) -->
              <g transform="translate(160 142) rotate(-12)">
                <rect x="-90" y="-100" width="180" height="200" rx="6" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2.5" stroke-linejoin="round"/>
                <rect x="-76" y="-86" width="152" height="148" rx="3" fill="#BFD6A8"/>
                <!-- tiny sky + sun + cloud illustration -->
                <rect x="-76" y="-86" width="152" height="60" rx="3" fill="#C7E5EE"/>
                <circle cx="34" cy="-66" r="10" fill="#F8D98F"/>
                <ellipse cx="-30" cy="-50" rx="16" ry="6" fill="#FBF5EA"/>
                <!-- a little house silhouette -->
                <rect x="-30" y="-24" width="40" height="34" rx="2" fill="#E09972"/>
                <polygon points="-30,-24 -10,-44 10,-24" fill="#A8472A"/>
                <rect x="-14" y="-10" width="10" height="20" rx="1" fill="#8A5A2C"/>
                <text x="0" y="84" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="14" fill="#5a2f1c" text-anchor="middle">Main Street</text>
                <!-- tape -->
                <rect x="-30" y="-110" width="60" height="14" fill="#F4DDB5" opacity="0.75"/>
              </g>

              <!-- middle polaroid (sky, tilted right) -->
              <g transform="translate(160 138) rotate(6)">
                <rect x="-86" y="-96" width="172" height="192" rx="6" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2.5" stroke-linejoin="round"/>
                <rect x="-72" y="-82" width="144" height="140" rx="3" fill="#FDE5C7"/>
                <!-- coffee cup illustration -->
                <ellipse cx="0" cy="50" rx="56" ry="6" fill="#E2C79B"/>
                <path d="M-40 -34 H40 L36 38 Q34 50 18 50 H-18 Q-34 50 -36 38 Z" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2"/>
                <path d="M40 -22 Q60 -20 60 0 Q60 22 40 20" fill="none" stroke="#8A5A2C" stroke-width="4" stroke-linecap="round"/>
                <ellipse cx="0" cy="-34" rx="40" ry="9" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2"/>
                <ellipse cx="0" cy="-34" rx="34" ry="7" fill="#E5C49A"/>
                <ellipse cx="0" cy="-34" rx="28" ry="5.5" fill="#8A5A2C"/>
                <path d="M0 -38 q-6 -5 -10 0 q-2 5 10 11 q12 -6 10 -11 q-4 -5 -10 0 Z" fill="#FBF5EA"/>
                <text x="0" y="86" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="14" fill="#5a2f1c" text-anchor="middle">Latte day</text>
              </g>

              <!-- front polaroid (cream, slight tilt) -->
              <g transform="translate(166 132) rotate(-3)">
                <rect x="-84" y="-94" width="168" height="186" rx="6" fill="#FBF5EA" stroke="#8A5A2C" stroke-width="2.5" stroke-linejoin="round"/>
                <rect x="-70" y="-80" width="140" height="136" rx="3" fill="#F2D6BD"/>
                <!-- two little kids playing illustration -->
                <ellipse cx="0" cy="52" rx="58" ry="6" fill="#E2C79B"/>
                <!-- left kid -->
                <g transform="translate(-28 8)">
                  <circle cx="0" cy="-14" r="12" fill="#F2D5BD"/>
                  <path d="M-8 -16 a8 8 0 0 1 16 0 q-8 -6 -16 0Z" fill="#7A4A28"/>
                  <circle cx="-3.5" cy="-12" r="1.3" fill="#3a322a"/>
                  <circle cx="3.5" cy="-12" r="1.3" fill="#3a322a"/>
                  <path d="M-3 -8 q3 3 6 0" stroke="#3a322a" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                  <path d="M-12 4 H12 V32 H-12 Z" fill="#E09972" stroke="#8A5A2C" stroke-width="1.4"/>
                </g>
                <!-- right kid -->
                <g transform="translate(28 8)">
                  <circle cx="0" cy="-14" r="12" fill="#F2D5BD"/>
                  <path d="M-8 -16 a8 8 0 0 1 16 0" fill="#A8472A"/>
                  <circle cx="-3.5" cy="-12" r="1.3" fill="#3a322a"/>
                  <circle cx="3.5" cy="-12" r="1.3" fill="#3a322a"/>
                  <path d="M-3 -8 q3 3 6 0" stroke="#3a322a" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                  <path d="M-12 4 H12 V32 H-12 Z" fill="#ABBE83" stroke="#8A5A2C" stroke-width="1.4"/>
                </g>
                <!-- balloon between -->
                <ellipse cx="0" cy="-24" rx="8" ry="10" fill="#E09972" stroke="#8A5A2C" stroke-width="1.3"/>
                <path d="M0 -14 q3 5 -1 12" stroke="#8A5A2C" stroke-width="1" fill="none"/>
                <text x="0" y="80" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="14" fill="#5a2f1c" text-anchor="middle">Best buds</text>
              </g>

              <!-- a little heart sparkle accent -->
              <path transform="translate(38 60) rotate(-10)" d="M0 6 C-7 0 -7 -7 0 -3 C7 -7 7 0 0 6 Z" fill="#A8472A" opacity="0.85"/>
              <path transform="translate(286 200) rotate(12)" d="M0 -6 q1.3 5 6 6 q-4.7 1 -6 6 q-1.3 -5 -6 -6 q4.7 -1 6 -6Z" fill="#E7BC76"/>
            </svg>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================== GALLERY · beat 1 (colour wash) ===================== -->
    <section class="section flow-top sec-color gallery-section" id="gallery">
      <div class="container">
        <div class="lt-car reveal" data-lt-carousel role="region" aria-roledescription="carousel" aria-label="Photos from inside Little Town">

          <ul class="lt-car-track" tabindex="0">
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="1 of 11: The whole little town">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-town-shops-600.avif' | asset_url }} 600w, {{ 'photo-town-shops-900.avif' | asset_url }} 900w, {{ 'photo-town-shops-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-town-shops-600.webp' | asset_url }} 600w, {{ 'photo-town-shops-900.webp' | asset_url }} 900w, {{ 'photo-town-shops-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-town-shops.jpg' | asset_url }}" alt="The full play floor at Little Town, with the Fusion Coffee and grocery storefronts along the back wall." decoding="async" draggable="false" style="object-position:center 50%">
                  </picture>
                  <figcaption><span>The whole little town</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="2 of 11: The play castle">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-play-bridge-600.avif' | asset_url }} 600w, {{ 'photo-play-bridge-900.avif' | asset_url }} 900w, {{ 'photo-play-bridge-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-play-bridge-600.webp' | asset_url }} 600w, {{ 'photo-play-bridge-900.webp' | asset_url }} 900w, {{ 'photo-play-bridge-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-play-bridge.jpg' | asset_url }}" alt="Kids peeking out of the portholes and sliding down the wooden play castle at Little Town." decoding="async" draggable="false" style="object-position:center 55%">
                  </picture>
                  <figcaption><span>The play castle</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="3 of 11: The big slides">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-play-slide-600.avif' | asset_url }} 600w, {{ 'photo-play-slide-900.avif' | asset_url }} 900w, {{ 'photo-play-slide-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-play-slide-600.webp' | asset_url }} 600w, {{ 'photo-play-slide-900.webp' | asset_url }} 900w, {{ 'photo-play-slide-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-play-slide.jpg' | asset_url }}" alt="Two kids racing down the slide beside the big blue tube slide." loading="lazy" decoding="async" draggable="false" style="object-position:center 55%">
                  </picture>
                  <figcaption><span>The big slides</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="4 of 11: Climbing the towers">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-play-climb-600.avif' | asset_url }} 600w, {{ 'photo-play-climb-900.avif' | asset_url }} 900w, {{ 'photo-play-climb-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-play-climb-600.webp' | asset_url }} 600w, {{ 'photo-play-climb-900.webp' | asset_url }} 900w, {{ 'photo-play-climb-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-play-climb.jpg' | asset_url }}" alt="A child climbing the wooden castle towers under the Little Town sign." loading="lazy" decoding="async" draggable="false" style="object-position:center 45%">
                  </picture>
                  <figcaption><span>Climbing the towers</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="5 of 11: The little clinic">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-clinic-600.avif' | asset_url }} 600w, {{ 'photo-clinic-900.avif' | asset_url }} 900w, {{ 'photo-clinic-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-clinic-600.webp' | asset_url }} 600w, {{ 'photo-clinic-900.webp' | asset_url }} 900w, {{ 'photo-clinic-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-clinic.jpg' | asset_url }}" alt="A grown-up and toddlers playing at the little clinic, with its first-aid cart and eye chart." loading="lazy" decoding="async" draggable="false" style="object-position:center 50%">
                  </picture>
                  <figcaption><span>The little clinic</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="6 of 11: The little grocery">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-grocery-600.avif' | asset_url }} 600w, {{ 'photo-grocery-900.avif' | asset_url }} 900w, {{ 'photo-grocery-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-grocery-600.webp' | asset_url }} 600w, {{ 'photo-grocery-900.webp' | asset_url }} 900w, {{ 'photo-grocery-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-grocery.jpg' | asset_url }}" alt="Two toddlers shopping the produce shelves at the little grocery." loading="lazy" decoding="async" draggable="false" style="object-position:center 42%">
                  </picture>
                  <figcaption><span>The little grocery</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="7 of 11: The little market">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-market-stall-600.avif' | asset_url }} 600w, {{ 'photo-market-stall-900.avif' | asset_url }} 900w, {{ 'photo-market-stall-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-market-stall-600.webp' | asset_url }} 600w, {{ 'photo-market-stall-900.webp' | asset_url }} 900w, {{ 'photo-market-stall-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-market-stall.jpg' | asset_url }}" alt="A toddler carrying a shopping basket past the little market stall." loading="lazy" decoding="async" draggable="false" style="object-position:center 45%">
                  </picture>
                  <figcaption><span>The little market</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="8 of 11: Behind the register">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-bigsmiles-600.avif' | asset_url }} 600w, {{ 'photo-bigsmiles-900.avif' | asset_url }} 900w, {{ 'photo-bigsmiles-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-bigsmiles-600.webp' | asset_url }} 600w, {{ 'photo-bigsmiles-900.webp' | asset_url }} 900w, {{ 'photo-bigsmiles-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-bigsmiles.jpg' | asset_url }}" alt="A toddler running the register at the little pretend market." loading="lazy" decoding="async" draggable="false" style="object-position:center 50%">
                  </picture>
                  <figcaption><span>Behind the register</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="9 of 11: Little chefs at work">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-play-blocks-600.avif' | asset_url }} 600w, {{ 'photo-play-blocks-900.avif' | asset_url }} 900w, {{ 'photo-play-blocks-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-play-blocks-600.webp' | asset_url }} 600w, {{ 'photo-play-blocks-900.webp' | asset_url }} 900w, {{ 'photo-play-blocks-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-play-blocks.jpg' | asset_url }}" alt="Two toddlers cooking together in the pretend-play kitchen, seen through the brick window." loading="lazy" decoding="async" draggable="false" style="object-position:center 45%">
                  </picture>
                  <figcaption><span>Little chefs at work</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="10 of 11: The play kitchen">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-kitchen-window-600.avif' | asset_url }} 600w, {{ 'photo-kitchen-window-900.avif' | asset_url }} 900w, {{ 'photo-kitchen-window-1200.avif' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-kitchen-window-600.webp' | asset_url }} 600w, {{ 'photo-kitchen-window-900.webp' | asset_url }} 900w, {{ 'photo-kitchen-window-1200.webp' | asset_url }} 1200w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-kitchen-window.jpg' | asset_url }}" alt="A grown-up and two children at a pretend tea party in the play kitchen, seen through the brick window." loading="lazy" decoding="async" draggable="false" style="object-position:center 45%">
                  </picture>
                  <figcaption><span>The play kitchen</span></figcaption>
                </figure>
              </li>
              <li class="lt-car-slide" role="group" aria-roledescription="slide" aria-label="11 of 11: Coffee with a view of play">
                <figure class="lt-car-fig">
                  <picture>
                    <source type="image/avif" srcset="{{ 'photo-cafe-table-600.avif' | asset_url }} 600w, {{ 'photo-cafe-table-900.avif' | asset_url }} 900w, {{ 'photo-cafe-table-1000.avif' | asset_url }} 1000w" sizes="(min-width: 900px) 62vw, 86vw">
                    <source type="image/webp" srcset="{{ 'photo-cafe-table-600.webp' | asset_url }} 600w, {{ 'photo-cafe-table-900.webp' | asset_url }} 900w, {{ 'photo-cafe-table-1000.webp' | asset_url }} 1000w" sizes="(min-width: 900px) 62vw, 86vw">
                    <img src="{{ 'photo-cafe-table.jpg' | asset_url }}" alt="The Fusion coffee counter and seating beside the Little Town play floor." loading="lazy" decoding="async" draggable="false" style="object-position:center 55%">
